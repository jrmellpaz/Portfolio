---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@lib/utils";

type Variant = "primary" | "outline";

type Props = HTMLAttributes<"a"> & {
	variant?: Variant;
};

const { variant = "primary", class: className, ...rest } = Astro.props;

// A link styled to match Button.astro. Rendering the <a> itself (rather than nesting one inside a
// <button>) keeps it a single focusable element — avoids the invalid markup and the double focus
// ring. `active:scale-96` replicates the globals.css `button:active` press feedback, which only
// targets <button>. Keep the styles below in sync with Button.astro.
const base =
	"group inline-flex items-center-safe font-medium gap-2 rounded-full px-5 py-2.5 text-sm active:scale-96";

const variants: Record<Variant, string> = {
	primary:
		"bg-primary selection:bg-primary-foreground selection:text-primary text-primary-foreground transition-opacity focus-visible:opacity-85 hover:opacity-85",
	outline: "border border-border transition-colors focus-visible:bg-secondary hover:bg-secondary",
};
---

<a class={cn(base, variants[variant], className)} {...rest}>
	<slot />
</a>
