---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@lib/utils";

type Variant = "primary" | "outline";

type Props = HTMLAttributes<"button"> & {
	variant?: Variant;
};

const { variant = "primary", class: className, ...rest } = Astro.props;

const base =
	"group text-md inline-flex items-center-safe font-medium gap-1.5 rounded-full px-4 py-3 text-[14px]";

const variants: Record<Variant, string> = {
	primary:
		"bg-primary selection:bg-primary-foreground selection:text-primary text-primary-foreground transition-opacity focus-visible:opacity-85 hover:opacity-85",
	outline:
		"text-foreground border border-border transition-colors focus-visible:bg-secondary hover:bg-secondary",
};
---

<button class={cn(base, variants[variant], className)} {...rest}>
	<slot />
</button>
